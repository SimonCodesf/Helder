{
  "name": "helder-flashcards",
  "version": "3.1.15",
  "private": true,
  "type": "module",
  "description": "Offline-first flashcards, geleidelijk leren met FSRS en optionele privésync. Geen build nodig.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/app.js",
    "test:browser": "node tests/browser-smoke.mjs && node tests/browser-mobile.mjs",
    "test:sync": "node tests/browser-sync.mjs",
    "test:database": "node tests/database-security.mjs",
    "test:public": "node scripts/public-check.mjs",
    "test:exploration": "node tests/exploration-browser.mjs",
    "test:email": "node tests/email-browser.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
